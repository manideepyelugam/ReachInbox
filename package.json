{
  "name": "reachinbox-email-scheduler",
  "version": "1.0.0",
  "description": "Production-grade Email Job Scheduler with BullMQ, Redis, Elasticsearch, Ethereal SMTP, and Slack Alerts",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:migrate": "npm run prisma:migrate --workspace=backend",
    "db:generate": "npm run prisma:generate --workspace=backend",
    "db:seed": "npm run seed --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "reachinbox",
    "bullmq",
    "redis",
    "email-scheduler",
    "nodemailer",
    "elasticsearch",
    "slack-oauth",
    "react",
    "typescript"
  ],
  "author": "ReachInbox Candidate",
  "license": "MIT"
}
